  "components": {
    "schemas": {
      "ApprovalInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "cancel",
              "edit"
            ],
            "title": "Action"
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Draft"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "version",
          "action"
        ],
        "title": "ApprovalInput"
      },
      "ChatResponse": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          },
          "draft": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Draft"
              },
              {
                "type": "null"
              }
            ]
          },
          "draft_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Version"
          },
          "tickets": {
            "items": {
              "$ref": "#/components/schemas/TicketView"
            },
            "type": "array",
            "title": "Tickets"
          },
          "pending_approval": {
            "type": "boolean",
            "title": "Pending Approval",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ChatResponse"
      },
      "Citation": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "excerpt",
          "source"
        ],
        "title": "Citation"
      },
      "ConversationView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageView"
            },
            "type": "array",
            "title": "Messages"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at"
        ],
        "title": "ConversationView"
      },
      "Draft": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "summary": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Summary"
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 10,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "enum": [
              "IT",
              "HR"
            ],
            "title": "Category",
            "default": "IT"
          },
          "priority": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "High",
              "Critical"
            ],
            "title": "Priority",
            "default": "Medium"
          }
        },
        "type": "object",
        "required": [
          "email",
          "summary",
          "description"
        ],
        "title": "Draft"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "text"
        ],
        "title": "MessageInput"
      },
      "MessageView": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "response": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content"
        ],
        "title": "MessageView"
      },
      "TicketView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "comments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "summary",
          "status",
          "url"
        ],
        "title": "TicketView"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
