# Copy to .env at repository root for Compose. Never commit .env.
ENVIRONMENT=development
AUTH_MODE=demo
DEMO_EMAIL=jane.doe@novatech.example
SESSION_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=local-smartdesk-change-me
DATABASE_URL=postgresql+psycopg://smartdesk:local-smartdesk-change-me@postgres:5432/smartdesk
CHECKPOINT_URL=postgresql://smartdesk:local-smartdesk-change-me@postgres:5432/smartdesk
OPENAI_API_KEY=
# Default example; used by application agents and the optional evaluation judge.
# Choose a model supported by the configured OpenAI adapter and structured Responses API.
LLM_MODEL=gpt-4o-mini
# Only set for reasoning models that support the chosen effort.
# REASONING_EFFORT=minimal
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Task
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=smartdesk_v1
QDRANT_API_KEY=
KNOWLEDGE_BASE_PATH=/knowledge_base
MODEL_CACHE_DIR=/model-cache
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# Optional model-specific score cutoff; disabled until calibrated on development cases.
# RERANKER_MIN_SCORE=-5.0
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
FRONTEND_OIDC_AUTHORITY=
FRONTEND_OIDC_CLIENT_ID=
# LangSmith tracing is opt-in. Keep payloads hidden for employee conversations.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
